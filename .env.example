# Completar con el origen final, sin barra al final. Sin dominio, la versión no es indexable.
NEXT_PUBLIC_SITE_URL=

# Supabase: Project Settings > API. URL y anon/publishable key, nunca service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sin Supabase, permite revisar los datos v5 localmente. En Netlify usar false.
# Si Supabase está configurado, NUNCA se vuelve silenciosamente a los datos locales.
FME_ALLOW_LOCAL_CONTENT=true
